# Required
SECRET_KEY=your-secret-key-here
ADMIN_PASSWORD=your-admin-password-here
# Encryption key for at-rest client passwords (Fernet).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Email — SMTP (recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password-here

# Email — Resend (alternative)
RESEND_API_KEY=re_123456789

# Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+14155552671

# Error tracking
SENTRY_DSN=https://key@sentry.io/project
# Tag Sentry events with this environment (development/staging/production).
# If unset, defaults to APP_ENV, then "production".
SENTRY_ENVIRONMENT=production
# Fraction of requests to trace (0.0–1.0). 0.1 is a sane default for low-volume apps.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Database
DB_PATH=canada/visactrl.db

# Flask
FLASK_DEBUG=true
PORT=5000

# Operational hardening
# APP_ENV controls default log level + Sentry environment fallback.
APP_ENV=development
# Master switch for Flask-Limiter. true in prod, false in tests (conftest sets it false).
RATELIMIT_ENABLED=true
# Per-process graceful shutdown budget (seconds). Must fit inside Cloud Run's
# terminationGracePeriod (5s default on Cloud Run, 25s on k8s).
SHUTDOWN_GRACE_SECONDS=25
