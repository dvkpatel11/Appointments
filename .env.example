# ─────────────────────────────────────────────────────────────────────────────
# VISA_CTRL — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin panel password — use a strong, unique password
ADMIN_PASSWORD=

# Set to "true" ONLY in local development
FLASK_DEBUG=false

# Port the Flask app listens on (8080 for Cloud Run / Render)
PORT=8080

# ── Email Notifications (SMTP) ────────────────────────────────────────────────
# For Gmail: enable 2FA and create an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Email Notifications (Resend) ──────────────────────────────────────────────
# Optional — alternative to SMTP. Get API key at https://resend.com
RESEND_API_KEY=

# ── Telegram Notifications ────────────────────────────────────────────────────
# Optional — get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SMS Notifications (Twilio) ────────────────────────────────────────────────
# Optional — get credentials at https://twilio.com/console
# TWILIO_FROM_NUMBER must include country code (e.g. +14155552671)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Sentry (optional error tracking) ──────────────────────────────────────────
SENTRY_DSN=

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=canada/visactrl.db
